# local = 本机助手（SQLite 备份 + 可选同步到远程）
# remote = 部署在 MySQL 旁边的双向同步服务
MODE=local
PORT=3001
BIND=127.0.0.1
JSON_LIMIT=100mb

# 本地库
DATA_DIR=./data
SQLITE_PATH=./data/jimeng.db

# 本地助手连远程时填写（也可在 http://127.0.0.1:3001/ 里配）
REMOTE_URL=
REMOTE_TOKEN=
AUTO_SYNC_MS=30000
TOMBSTONE_TTL_DAYS=90

# 本机落盘原图（采集时慢慢下，不重编码；不要设太快）
IMAGE_DIR=./data/images
IMAGE_DELAY_MS=2800
IMAGE_BACKFILL=1

# 仅 MODE=remote / start-remote.bat 需要
# 本地试跑可留空，启动器会自动生成并写入 data/config.json
SYNC_TOKEN=local-dev-token
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jimeng
DB_CONNECTION_LIMIT=10
